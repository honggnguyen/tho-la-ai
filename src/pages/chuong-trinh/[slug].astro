---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PoemCard from '../../components/PoemCard.astro';
import gallery from '../../data/gallery.json';
import poems from '../../data/poems.json';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const all = await getCollection('events');
  return all.map((e) => ({ params: { slug: e.id }, props: { e } }));
}
const { e } = Astro.props;
const { Content } = await render(e);
const d = e.data;
const statusLabel: Record<string, string> = { done: 'Đã diễn ra', ongoing: 'Đang diễn ra', planned: 'Dự kiến' };
const photos = gallery.filter((g) => g.eventSlug === e.id);
const hero = d.cover || photos.find((p) => p.width >= p.height)?.src;
const eventPoems = poems.filter((p) => p.eventSlug === e.id);
---
<Base title={d.title} description={d.summary} image={hero}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow"><a href={u('/chuong-trinh')} style="text-decoration:none">← Chương trình</a></p>
      <span class={`tag ${d.status}`}>{statusLabel[d.status]} · {d.type}</span>
      <h1 class="shadowed" style="margin-top:1rem">{d.title}</h1>
      {d.subtitle && <p class="lead">{d.subtitle}</p>}

      {hero && <img class="ev-hero" src={u(hero)} alt={d.title} style="margin-top:2rem" />}

      <div class="ev-layout">
        <aside class="ev-aside" aria-label="Thông tin chương trình">
          <dl style="margin:0;display:grid;gap:1rem">
            {d.dateLabel && <div><dt>Thời gian</dt><dd>{d.dateLabel}</dd></div>}
            {d.venue && <div><dt>Địa điểm</dt><dd>{d.venue}</dd></div>}
            {d.attendeesLabel && <div><dt>Quy mô</dt><dd>{d.attendeesLabel}</dd></div>}
            {d.partners.length > 0 && <div><dt>Đồng hành</dt><dd>{d.partners.join(', ')}</dd></div>}
            {d.instagramPosts.length > 0 && (
              <div>
                <dt>Bài viết Instagram</dt>
                <dd>
                  {d.instagramPosts.map((url, idx) => (
                    <><a href={url} target="_blank" rel="noopener">Bài #{idx + 1} ↗</a>{idx < d.instagramPosts.length - 1 && ' · '}</>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        </aside>
        <div>
          <div class="prose"><p style="font-size:1.25rem;margin-top:0">{d.summary}</p><Content /></div>
          {d.youtube && (
            <div style="margin-top:2rem;aspect-ratio:16/9;max-width:800px">
              <iframe width="100%" height="100%" src={`https://www.youtube-nocookie.com/embed/${d.youtube}`} title={d.title} loading="lazy" allowfullscreen style="border:0"></iframe>
            </div>
          )}
        </div>
      </div>

      {eventPoems.length > 0 && (
        <div style="margin-top:4rem">
          <p class="eyebrow">Tác phẩm &amp; bản thu âm</p>
          <h2>Thơ &amp; thanh âm</h2>
          <div class="grid cols-2 top" style="margin-top:1.25rem">
            {eventPoems.map((p) => <PoemCard poem={p} showProgram={false} />)}
          </div>
        </div>
      )}

      {photos.length > 0 && (
        <div style="margin-top:4rem">
          <div class="section-head">
            <div>
              <p class="eyebrow">Tư liệu hình ảnh · {photos.length} tư liệu (Chạm vào ảnh để phóng to)</p>
              <h2>Khoảnh khắc</h2>
            </div>
            <a class="link-arrow" href={u(`/thu-vien#album-${e.id}`)}>Xem trọn bộ {photos.length} ảnh &amp; bản thảo tại Thư viện →</a>
          </div>
          <div class="album-grid" style="margin-top:1.25rem">
            {photos.slice(0, 8).map((img, idx) => (
              <button
                type="button"
                class="gallery-item ev-lb-trigger"
                data-idx={idx}
                data-src={u(img.src)}
                data-title={img.title}
                data-prog={img.kind === 'product' ? '✦ Sản phẩm lưu trữ' : d.title}
              >
                <div class="gallery-thumb-box">
                  <img src={u(img.src)} width={img.width} height={img.height} alt={img.title} loading="lazy" />
                </div>
                <div class="gallery-caption">
                  <span class="prog">{img.kind === 'product' ? '✦ Sản phẩm lưu trữ' : d.title}</span>
                  <span>{img.title}</span>
                </div>
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  {photos.length > 0 && (
    <dialog class="lightbox" id="ev-lightbox" aria-label="Xem ảnh phóng to" data-photos={JSON.stringify(photos.map((p) => ({ src: u(p.src), title: p.title, prog: p.kind === 'product' ? '✦ Sản phẩm lưu trữ' : d.title })))}>
      <div class="lb-body">
        <div class="lb-bar">
          <span id="ev-lb-caption"></span>
          <div style="display:flex;gap:.5rem">
            <button type="button" id="ev-lb-prev" aria-label="Ảnh trước">← Trước</button>
            <button type="button" id="ev-lb-next" aria-label="Ảnh tiếp">Tiếp →</button>
            <button type="button" id="ev-lb-close" aria-label="Đóng">Đóng ✕</button>
          </div>
        </div>
        <img id="ev-lb-img" src="" alt="" />
        <div class="lb-bar">
          <a href={u(`/thu-vien#album-${e.id}`)}>Mở toàn bộ Album trong Thư viện ảnh →</a>
          <span id="ev-lb-count" class="meta"></span>
        </div>
      </div>
    </dialog>
  )}
</Base>

<script>
  const dlg = document.getElementById('ev-lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const allPhotos = JSON.parse(dlg.dataset.photos || '[]');
    const lbImg = document.getElementById('ev-lb-img') as HTMLImageElement;
    const lbCap = document.getElementById('ev-lb-caption')!;
    const lbCount = document.getElementById('ev-lb-count')!;
    let cur = 0;

    const show = (i: number) => {
      if (!allPhotos.length) return;
      cur = (i + allPhotos.length) % allPhotos.length;
      const p = allPhotos[cur];
      lbImg.src = p.src;
      lbImg.alt = p.title;
      lbCap.textContent = `${p.prog} · ${p.title}`;
      lbCount.textContent = `Tư liệu ${cur + 1} / ${allPhotos.length}`;
    };

    document.querySelectorAll<HTMLButtonElement>('.ev-lb-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.idx || '0', 10);
        show(idx);
        dlg.showModal();
      });
    });

    document.getElementById('ev-lb-prev')?.addEventListener('click', () => show(cur - 1));
    document.getElementById('ev-lb-next')?.addEventListener('click', () => show(cur + 1));
    document.getElementById('ev-lb-close')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    window.addEventListener('keydown', (e) => {
      if (!dlg.open) return;
      if (e.key === 'ArrowLeft') show(cur - 1);
      if (e.key === 'ArrowRight') show(cur + 1);
      if (e.key === 'Escape') dlg.close();
    });
  }
</script>
