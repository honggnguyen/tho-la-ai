---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import gallery from '../../data/gallery.json';
import { u } from '../../lib/url';

const all = await getCollection('events');
const byDate = (a: any, b: any) => (b.data.sortDate?.getTime() ?? 0) - (a.data.sortDate?.getTime() ?? 0);
const done = all.filter((e) => e.data.status !== 'planned').sort(byDate);
const planned = all.filter((e) => e.data.status === 'planned');
const years = [...new Set(done.map((e) => e.data.sortDate!.getFullYear()))];
const cover = (slug: string, c?: string) => c || gallery.find((g) => g.eventSlug === slug)?.src;
const statusLabel: Record<string, string> = { done: '', ongoing: 'Đang diễn ra', planned: 'Dự kiến' };
---
<Base title="Chương trình">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Lưu trữ &amp; kế hoạch</p>
      <h1 class="shadowed">Chương trình</h1>
      <p class="lead">Từ đêm thơ đầu tiên ở Kim Mã đến mạng lưới OMLAS nhiều quốc gia: mỗi chương trình là một cách khác nhau để hỏi &ldquo;thơ là ai?&rdquo;.</p>

      {years.map((y) => (
        <>
          <div class="year-mark">{y}</div>
          <ol class="timeline">
            {done.filter((e) => e.data.sortDate!.getFullYear() === y).map((e) => (
              <li>
                <a class="t-row" href={u(`/chuong-trinh/${e.id}`)}>
                  <div class="t-date">{e.data.dateLabel}</div>
                  <div class="t-main">
                    <span class={`tag ${e.data.status}`}>{e.data.status === 'ongoing' ? 'Đang diễn ra' : e.data.type}</span>
                    <h3>{e.data.title}</h3>
                    {e.data.subtitle && <span class="meta">{e.data.subtitle}</span>}
                    <p>{e.data.summary}</p>
                    <p class="meta">{[e.data.venue, e.data.attendeesLabel].filter(Boolean).join(' · ')}</p>
                  </div>
                  {cover(e.id, e.data.cover) && <img class="t-thumb" src={u(cover(e.id, e.data.cover)!)} alt="" loading="lazy" />}
                </a>
              </li>
            ))}
          </ol>
        </>
      ))}

      {planned.length > 0 && (
        <>
          <div class="year-mark">Sắp tới</div>
          <p class="meta">Những ý tưởng đang ấp ủ, chưa triển khai.</p>
          <ol class="timeline" style="margin-top:1rem">
            {planned.map((e) => (
              <li>
                <a class="t-row planned" href={u(`/chuong-trinh/${e.id}`)} style="grid-template-columns:150px minmax(0,1fr)">
                  <div class="t-date">Dự kiến</div>
                  <div class="t-main">
                    <span class="tag planned">{e.data.type}</span>
                    <h3>{e.data.title}</h3>
                    <p>{e.data.summary}</p>
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </>
      )}
    </div>
  </section>
</Base>
