---
import Base from '../layouts/Base.astro';
import BarList from '../components/BarList.astro';
import LineChart from '../components/LineChart.astro';
import Dumbbell from '../components/Dumbbell.astro';
import stats from '../data/stats.json';

const ig = [
  ...stats.instagram.milestones.map((m) => ({ label: m.label, value: m.followers })),
  { label: 'Hiện tại', value: stats.instagram.latest_followers },
];

const dist = stats.dem1.rating.dist as Record<string, number>;
const dots = [5, 4, 3, 2, 1].flatMap((s) => Array.from({ length: dist[String(s)] ?? 0 }, () => s));
const dotsTht = [4, 4];
const walkinChongChu = stats.chongchu.total_participants - stats.chongchu.form_registrations;
---
<Base title="Báo cáo Tác động & Phân tích Dữ liệu" description="Phân tích chi tiết tác động xã hội, chân dung khán giả liên ngành, độ phủ truyền thông và di sản sáng tác của dự án Thơ-là-ai? (TLA).">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Báo cáo Tác động · Dữ liệu mở đã ẩn danh (10/2025 – 05/2026)</p>
      <h1 class="shadowed">Tác động &amp; Phân tích Dữ liệu</h1>
      <p class="lead">
        Báo cáo này tổng hợp toàn bộ dữ liệu định lượng và định tính từ <strong>8 bộ hồ sơ gốc</strong> của dự án <em>Thơ-là-ai? (TLA)</em> qua 7 tháng hoạt động: từ các đêm thơ thể nghiệm, chuỗi workshop tại Hà Nội đến chương trình giáo dục sáng tạo liên quốc gia <em>OMLAS · Echoes of Asia</em>.
      </p>

      <div class="callout">
        <strong>Nguyên tắc Minh bạch &amp; Bảo mật Dữ liệu:</strong> Toàn bộ số liệu dưới đây được trích xuất tự động từ biểu mẫu đăng ký, danh sách check-in, khảo sát sau sự kiện và hệ thống lưu trữ sáng tác của dự án. Để bảo vệ tuyệt đối quyền riêng tư của người tham dự, chúng tôi <strong>không công bố họ tên, email, số điện thoại, liên kết cá nhân hay dữ liệu tài chính</strong>. Mọi biểu đồ đều ghi rõ cỡ mẫu (<em>n</em>), nguồn trích xuất và gộp các nhóm dưới 3 người vào mục &ldquo;Khác&rdquo;.
      </div>

      <nav class="impact-nav-pills" aria-label="Mục lục báo cáo tác động">
        <a href="#tong-quan">00 · Tổng quan</a>
        <a href="#do-phu-kenh">01 · Độ phủ &amp; Kênh truyền thông</a>
        <a href="#chan-dung">02 · Chân dung Liên ngành</a>
        <a href="#trai-nghiem">03 · Trải nghiệm &amp; Di sản Sáng tác</a>
        <a href="#omlas">04 · Tác động Quốc tế (OMLAS)</a>
        <a href="#nguon-du-lieu">05 · Bảng Nguồn Dữ liệu</a>
      </nav>

      <!-- ================= 00. EXECUTIVE SUMMARY KPI GRID ================= -->
      <div id="tong-quan">
        <div class="impact-kpi-grid">
          <div class="impact-kpi-card accent-cobalt">
            <span class="impact-kpi-tag">Độ phủ hai nền tảng</span>
            <div class="impact-kpi-num">{stats.instagram.total_social_followers.toLocaleString('vi-VN')}+</div>
            <div class="impact-kpi-label">Tổng người theo dõi mạng xã hội</div>
            <div class="impact-kpi-sub">
              Kết hợp <strong>~{stats.instagram.facebook_followers.toLocaleString('vi-VN')}</strong> trên Facebook (độ phủ đại chúng) &amp; <strong>{stats.instagram.latest_followers}</strong> trên Instagram (+{stats.instagram.growth_pct}% sau 7 mốc).
            </div>
          </div>

          <div class="impact-kpi-card accent-crimson">
            <span class="impact-kpi-tag">Tương tác trực tiếp</span>
            <div class="impact-kpi-num">{stats.overview.total_registrations_and_surveys}</div>
            <div class="impact-kpi-label">Lượt đăng ký &amp; phản hồi khảo sát</div>
            <div class="impact-kpi-sub">
              Gồm <strong>{stats.overview.vn_registrations}</strong> lượt đăng ký/tham dự tại Hà Nội và <strong>{stats.overview.intl_surveys}</strong> lượt khảo sát &amp; ứng tuyển quốc tế OMLAS.
            </div>
          </div>

          <div class="impact-kpi-card accent-terracotta">
            <span class="impact-kpi-tag">Phá vỡ biên giới ngành</span>
            <div class="impact-kpi-num">{stats.audience_profile.non_literature_pct.toString().replace('.', ',')}%</div>
            <div class="impact-kpi-label">Khán giả ngoài ngành Văn chương</div>
            <div class="impact-kpi-sub">
              Đến từ Công nghệ AI/IT (26,3%), Thiết kế – Truyền thông (21,1%), Kinh tế – Luật (10,5%) và Y tế – Dịch vụ (10,5%) (<em>n = {stats.audience_profile.majors_n}</em>).
            </div>
          </div>

          <div class="impact-kpi-card accent-ochre">
            <span class="impact-kpi-tag">Tác động mở đường</span>
            <div class="impact-kpi-num">{stats.dem1.first_time.first_time_pct.toString().replace('.', ',')}%</div>
            <div class="impact-kpi-label">Lần đầu tiếp xúc thơ diễn xướng</div>
            <div class="impact-kpi-sub">
              {stats.dem1.first_time.first_time_count}/{stats.dem1.first_time.n} người khảo sát ở Đêm thơ #1 chưa từng dự sự kiện thơ diễn xướng trước đó; <strong>100%</strong> muốn cất tiếng đối thoại.
            </div>
          </div>

          <div class="impact-kpi-card accent-sage">
            <span class="impact-kpi-tag">Chất lượng chương trình</span>
            <div class="impact-kpi-num">{stats.dem1.rating.mean.toString().replace('.', ',')} / 5</div>
            <div class="impact-kpi-label">Điểm hài lòng Đêm thơ đầu tiên</div>
            <div class="impact-kpi-sub">
              100% đánh giá ở mức 4–5 sao (<em>n = {stats.dem1.rating.n}</em>); tỉ lệ gắn bó nhiều buổi ở chuỗi <em>Nghe–Thấy–Nhau</em> đạt <strong>{stats.aqm.multi_session_pct.toString().replace('.', ',')}%</strong>.
            </div>
          </div>

          <div class="impact-kpi-card accent-crimson">
            <span class="impact-kpi-tag">Tự chủ truyền thông</span>
            <div class="impact-kpi-num">6,7% → 70%</div>
            <div class="impact-kpi-label">Tăng trưởng kênh tự nhiên của TLA</div>
            <div class="impact-kpi-sub">
              Tỉ trọng người biết đến sự kiện trực tiếp qua Fanpage/IG <em>Thơ-là-ai?</em> tăng gấp 10 lần từ tháng 11/2025 đến tháng 05/2026.
            </div>
          </div>

          <div class="impact-kpi-card accent-cobalt">
            <span class="impact-kpi-tag">Di sản sáng tác cộng đồng</span>
            <div class="impact-kpi-num">{stats.overview.handwritten_manuscripts}</div>
            <div class="impact-kpi-label">Bản thảo viết tay &amp; thơ cắt dán</div>
            <div class="impact-kpi-sub">
              Cùng <strong>{stats.overview.poems_archived}</strong> bài thơ hoàn chỉnh, <strong>{stats.overview.audio_tracks}</strong> bản thu âm gốc, <strong>{stats.overview.zine_pages}</strong> trang Zine song ngữ và <strong>{stats.overview.event_photos}</strong> tư liệu ảnh.
            </div>
          </div>

          <div class="impact-kpi-card accent-sage">
            <span class="impact-kpi-tag">Lan tỏa khu vực châu Á</span>
            <div class="impact-kpi-num">{stats.omlas.champions_selected} Thủ lĩnh</div>
            <div class="impact-kpi-label">OMLAS · Echoes of Asia</div>
            <div class="impact-kpi-sub">
              Tuyển chọn <strong>{stats.omlas.champions_selected}/{stats.omlas.champions_applicants}</strong> OMLAS Champions (Bangladesh, Việt Nam, Uzbekistan...); <strong>{stats.omlas.commitment_pct.toString().replace('.', ',')}%</strong> học viên cam kết đi trọn lộ trình.
            </div>
          </div>
        </div>
      </div>

      <!-- ================= 01. DIGITAL REACH & CHANNEL MATURITY ================= -->
      <div id="do-phu-kenh" class="impact-section-head">
        <span class="section-idx">Phần 01 · Độ phủ Trực tuyến &amp; Kênh Tiếp cận</span>
        <h2>Từ mạng lưới cá nhân đến hệ sinh thái truyền thông tự chủ</h2>
        <p>
          Để đánh giá toàn diện sức lan tỏa của một dự án nghệ thuật độc lập, chúng tôi kết hợp đồng thời số liệu từ cả <strong>Facebook</strong> (kênh đại chúng cập nhật sự kiện dài hơi) và <strong>Instagram</strong> (kênh thị giác tương tác sâu với người trẻ theo từng mốc chương trình).
        </p>
      </div>

      <div class="social-dual-grid">
        <div class="social-stat-card highlight">
          <span class="plat-badge">Tổng hợp đa nền tảng (FB + IG)</span>
          <div class="plat-num">{stats.instagram.total_social_followers.toLocaleString('vi-VN')}+</div>
          <div class="plat-desc">
            Tổng quy mô khán giả theo dõi thường xuyên trên hai kênh chính thức của <em>Thơ-là-ai?</em> tính đến kỳ thống kê {stats.instagram.latest_asof}.
          </div>
        </div>

        <div class="social-stat-card">
          <span class="plat-badge">Facebook Fanpage · Độ phủ đại chúng</span>
          <div class="plat-num" style="color:var(--chart-cobalt)">~{stats.instagram.facebook_followers.toLocaleString('vi-VN')}</div>
          <div class="plat-desc">
            Nền tảng chủ lực lan tỏa các bài tiểu luận thơ, thông cáo báo chí, mở đơn đăng ký sự kiện và kết nối mạng lưới đối tác văn hóa – học thuật.
          </div>
        </div>

        <div class="social-stat-card">
          <span class="plat-badge">Instagram (@tholaai) · Tăng trưởng +{stats.instagram.growth_pct}%</span>
          <div class="plat-num" style="color:var(--brand-crimson)">{stats.instagram.latest_followers}</div>
          <div class="plat-desc">
            Tăng gấp <strong>10,1 lần</strong> từ con số 50 người theo dõi ở Đêm thơ đầu tiên (11/2025) lên 508 người theo dõi qua 7 cột mốc chương trình liên tiếp.
          </div>
        </div>
      </div>

      <LineChart
        title="Đường cong tăng trưởng người theo dõi Instagram (@tholaai) qua 7 cột mốc chương trình"
        points={ig}
        strokeColor="var(--chart-cobalt)"
        note={`Nguồn: Nhật ký truyền thông của Ban tổ chức và thống kê tài khoản @tholaai tính đến ${stats.instagram.latest_asof}. Mức tăng trưởng lũy kế đạt +${stats.instagram.growth_pct}% (từ 50 lên 508 người theo dõi).`}
      />

      <div class="impact-insight-box crimson">
        <div class="impact-insight-title">Phát hiện trọng tâm #1 · Sự trưởng thành của thương hiệu độc lập</div>
        <p>
          Phân tích đối chiếu câu hỏi <em>&ldquo;Bạn biết đến chương trình qua kênh nào?&rdquo;</em> trên <strong>n = {stats.channels_summary.total_respondents} người trả lời</strong> qua các giai đoạn cho thấy sự chuyển dịch rõ rệt: Ở buổi đầu tiên (11/2025), dự án phụ thuộc chủ yếu vào lời mời truyền miệng của bạn bè (70%) và chỉ có <strong>6,7%</strong> đến từ trang chính thức. Đến tháng 05/2026 (Workshop <em>Đưa thơ về mặt đất</em>), <strong>70,0%</strong> người đăng ký đến trực tiếp từ Fanpage/Instagram của <em>Thơ-là-ai?</em> — minh chứng cho khả năng thu hút khán giả tự nhiên (organic reach) của dự án.
        </p>
        <div class="shift-step-grid">
          {stats.channels_summary.fanpage_share_trend.map((s) => (
            <div class="shift-step">
              <div class="step-date">{s.event}</div>
              <div class="step-pct">{s.pct.toString().replace('.', ',')}%</div>
              <div class="step-bar"><div class="step-bar-fill" style={`width:${s.pct}%`}></div></div>
              <div class="step-meta">Biết qua Fanpage / IG dự án (<em>n = {s.n}</em>)</div>
            </div>
          ))}
        </div>
      </div>

      <div class="grid cols-2 top" style="margin-top:1.5rem">
        <BarList
          title="Tổng hợp nguồn tiếp cận qua 4 chương trình (Gộp chung)"
          items={stats.channels_summary.aggregate}
          n={stats.channels_summary.total_respondents}
          unit="lượt"
          color="cobalt"
          note="Câu hỏi nhiều lựa chọn (Multiple-choice); tổng số lượt chọn lớn hơn số người trả lời (n = 69)."
        />
        <BarList
          title="Đêm thơ #1: Thơ-là-ai? (11/2025)"
          items={stats.dem1.channels}
          n={stats.dem1.channels_n}
          unit="lượt"
          color="crimson"
          note="Giai đoạn khởi đầu: Mạng lưới bạn bè, người thân đóng vai trò hạt giống (21/30 lượt)."
        />
      </div>

      <div class="grid cols-3 top" style="margin-top:1.25rem">
        <BarList
          title='Series "Nghe–Thấy–Nhau" (12/2025)'
          items={stats.aqm.channels}
          n={stats.aqm.channels_n}
          unit="lượt"
          color="sage"
          note="Cộng hưởng lớn từ đối tác không gian nghệ thuật A Queer Museum (12/20 lượt)."
        />
        <BarList
          title='Series "Chồng chữ" (03/2026)'
          items={stats.chongchu.channels}
          n={stats.chongchu.channels_n}
          unit="lượt"
          color="ochre"
          note="Mẫu form đăng ký trước (n = 9); ngoài ra còn có 14 người tham dự trực tiếp tại sự kiện."
        />
        <BarList
          title='Workshop "Đưa thơ về mặt đất" (05/2026)'
          items={stats.tanhinhthuc.channels}
          n={stats.tanhinhthuc.channels_n}
          unit="lượt"
          color="terracotta"
          note="70% người đăng ký chủ động tìm đến từ chính kênh truyền thông của Thơ-là-ai?."
        />
      </div>

      <!-- ================= 02. AUDIENCE DEMOGRAPHICS & INTERDISCIPLINARY REACH ================= -->
      <div id="chan-dung" class="impact-section-head">
        <span class="section-idx">Phần 02 · Chân dung Người tham dự (&ldquo;Ai đến với Thơ?&rdquo;)</span>
        <h2>Phá vỡ định kiến &ldquo;tháp ngà văn chương&rdquo;: 68,4% người tham dự đến từ ngoài ngành Văn học</h2>
        <p>
          Một trong những câu hỏi cốt lõi của <em>Thơ-là-ai?</em> là liệu thơ ca đương đại có thể chạm tới những người trẻ làm việc trong các lĩnh vực kỹ thuật, công nghệ và kinh tế hay không. Dữ liệu khảo sát chuyên ngành và công việc từ 3 chương trình tại Hà Nội đã đưa ra câu trả lời thuyết phục.
        </p>
      </div>

      <div class="impact-insight-box sage">
        <div class="impact-insight-title">Phát hiện trọng tâm #2 · Giao điểm giữa Thơ ca và Công nghệ – Thiết kế – Khoa học</div>
        <p>
          Trong tổng số <strong>n = {stats.audience_profile.majors_n} bản khai thông tin ngành học/nghề nghiệp</strong> (gộp từ <em>Nghe–Thấy–Nhau</em>, <em>Chồng chữ</em> và <em>Đưa thơ về mặt đất</em>), có tới <strong>{stats.audience_profile.non_literature_pct.toString().replace('.', ',')}% (26/38 người)</strong> học tập và làm việc ngoài khối Khoa học Xã hội – Nhân văn. Đáng chú ý nhất, nhóm <strong>Công nghệ (AI, IT, Khoa học máy tính), Kỹ thuật &amp; Khoa học tự nhiên</strong> chiếm tỉ trọng lớn thứ hai (<strong>26,3%</strong> — 10/38 người), theo sát là nhóm <strong>Thiết kế đồ họa, Truyền thông &amp; Tổ chức sự kiện</strong> (<strong>21,1%</strong> — 8/38 người).
        </p>
      </div>

      <div class="grid cols-2 top" style="margin-top:1.5rem">
        <BarList
          title="Cơ cấu ngành học & lĩnh vực công việc của người tham dự tại Việt Nam"
          items={stats.audience_profile.majors}
          n={stats.audience_profile.majors_n}
          unit="người"
          color="cobalt"
          note="Tổng hợp từ hồ sơ đăng ký Nghe–Thấy–Nhau (n = 20), Chồng chữ (n = 9) và Đưa thơ về mặt đất (n = 9)."
        />
        <BarList
          title="Phân bố độ tuổi người tham dự tại Hà Nội (Gộp các chuỗi workshop)"
          items={stats.audience_profile.age_vn_buckets}
          n={stats.audience_profile.age_vn_n}
          unit="người"
          color="sage"
          note="Cân bằng giữa nhóm sinh viên đại học (Đến 22 tuổi: 53,3%) và người trẻ đã đi làm / học sau đại học (Trên 22 tuổi: 46,7%)."
        />
      </div>

      <div class="grid cols-2 top" style="margin-top:1.25rem">
        <BarList
          title='Số lượng người đăng ký theo từng buổi · Series "Nghe–Thấy–Nhau"'
          items={stats.aqm.sessions_breakdown}
          n={stats.aqm.registrations}
          unit="người"
          color="terracotta"
          note="Quy mô tăng dần qua từng buổi: Buổi 3 (15 người) tăng hơn gấp đôi so với Buổi 1 (7 người), tạo ra tổng cộng 32 lượt tham dự."
        />
        <figure class="figure chart-crimson">
          <h3>Mức độ gắn bó đa buổi (Retention Rate)</h3>
          <span class="n-badge">n = {stats.aqm.registrations} người đăng ký độc lập</span>
          <div class="rating-display" style="margin-top:1.2rem">
            <span class="rating-num" style="color:var(--brand-crimson)">{stats.aqm.multi_session_pct.toString().replace('.', ',')}%</span>
            <span class="rating-max">tham dự từ 2 đến 3 buổi liên tiếp</span>
          </div>
          <p style="font-family:var(--font-ui);font-size:.92rem;color:var(--ink-soft);margin:.8rem 0 0;line-height:1.55">
            Trong số <strong>{stats.aqm.registrations} người</strong> đăng ký chuỗi <em>Nghe–Thấy–Nhau</em>, có <strong>{stats.aqm.multi_session_count} người ({stats.aqm.multi_session_pct.toString().replace('.', ',')}%)</strong> đăng ký tham gia từ 2 buổi trở lên (tạo thành <strong>{stats.aqm.total_session_slots} lượt chỗ ngồi</strong>). Ngoài ra, <strong>{stats.aqm.archive_consent_pct.toString().replace('.', ',')}%</strong> người tham dự ngay từ khâu đăng ký đã đồng ý đóng góp sáng tác cá nhân vào triển lãm chung.
          </p>
          <figcaption>Nguồn: Sổ theo dõi đăng ký theo buổi Series &ldquo;Nghe–Thấy–Nhau&rdquo; (12/2025).</figcaption>
        </figure>
      </div>

      <!-- ================= 03. EXPERIENTIAL IMPACT & CREATIVE OUTPUTS ================= -->
      <div id="trai-nghiem" class="impact-section-head">
        <span class="section-idx">Phần 03 · Tác động Trải nghiệm, Mở đường &amp; Di sản Sáng tác</span>
        <h2>Từ người nghe thụ động thành người đồng sáng tạo</h2>
        <p>
