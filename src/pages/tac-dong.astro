---
import Base from '../layouts/Base.astro';
import BarList from '../components/BarList.astro';
import LineChart from '../components/LineChart.astro';
import Dumbbell from '../components/Dumbbell.astro';
import stats from '../data/stats.json';

const ig = [
  ...stats.instagram.milestones.map((m) => ({ label: m.label, value: m.followers })),
  { label: 'Hiện tại', value: stats.instagram.latest_followers },
];

const dist = stats.dem1.rating.dist as Record<string, number>;
const dots = [5, 4, 3, 2, 1].flatMap((s) => Array.from({ length: dist[String(s)] ?? 0 }, () => s));
const dotsTht = [4, 4];
const walkinChongChu = stats.chongchu.total_participants - stats.chongchu.form_registrations;
const walkinPct = ((walkinChongChu / stats.chongchu.total_participants) * 100).toFixed(1).replace('.', ',');
const fbSharePct = ((stats.instagram.facebook_followers / stats.instagram.total_social_followers) * 100).toFixed(1).replace('.', ',');
const igSharePct = ((stats.instagram.latest_followers / stats.instagram.total_social_followers) * 100).toFixed(1).replace('.', ',');
const vnSharePct = ((stats.overview.vn_registrations / stats.overview.total_registrations_and_surveys) * 100).toFixed(1).replace('.', ',');
const intlSharePct = ((stats.overview.intl_surveys / stats.overview.total_registrations_and_surveys) * 100).toFixed(1).replace('.', ',');
const dem1SatisfactionPct = ((stats.dem1.rating.mean / 5) * 100).toFixed(1).replace('.', ',');
const championsSelectPct = ((stats.omlas.champions_selected / stats.omlas.champions_applicants) * 100).toFixed(1).replace('.', ',');
---
<Base title="Báo cáo Tác động & Phân tích Dữ liệu (%)" description="Phân tích chi tiết tác động xã hội theo tỉ lệ phần trăm (%), chân dung khán giả liên ngành, độ phủ truyền thông và di sản sáng tác của dự án Thơ-là-ai? (TLA).">
  <section class="section">
    <div class="wrap">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:1rem">
        <div>
          <p class="eyebrow">Báo cáo Tác động · Dữ liệu mở chuẩn hóa theo Tỉ lệ % (10/2025 – 05/2026)</p>
          <h1 class="shadowed" style="margin-bottom:0">Tác động &amp; Phân tích Dữ liệu</h1>
        </div>
        <button type="button" class="btn ghost no-print" id="print-report-btn" title="In hoặc Lưu báo cáo dưới dạng PDF">
          ⬇ Xuất Báo cáo (PDF)
        </button>
      </div>

      <p class="lead" style="margin-top:1rem">
        Báo cáo này tổng hợp toàn bộ dữ liệu định lượng từ <strong>8 bộ hồ sơ gốc</strong> của dự án <em>Thơ-là-ai? (TLA)</em> qua 7 tháng hoạt động, chuẩn hóa đồng bộ sang <strong>hệ quy chiếu Tỉ lệ phần trăm (%)</strong> kèm cỡ mẫu thực tế (<em>n</em>) để phản ánh chính xác cơ cấu khán giả, tốc độ tăng trưởng và hiệu quả chuyển đổi.
      </p>

      <div class="callout">
        <strong>Nguyên tắc Minh bạch &amp; Bảo mật Dữ liệu:</strong> Toàn bộ tỉ lệ <strong>%</strong> dưới đây được tính toán trực tiếp trên cỡ mẫu phản hồi hợp lệ (<em>n</em>) của từng câu hỏi/sự kiện và đính kèm số lượng tuyệt đối trong ngoặc đơn <code>(n)</code>. Để bảo vệ tuyệt đối quyền riêng tư của người tham dự, chúng tôi <strong>không công bố họ tên, email, số điện thoại, liên kết cá nhân hay dữ liệu tài chính</strong>.
      </div>

      <nav class="impact-nav-pills no-print" aria-label="Mục lục báo cáo tác động">
        <a href="#tong-quan">00 · Chỉ số % Tổng quan</a>
        <a href="#do-phu-kenh">01 · % Tăng trưởng &amp; Kênh</a>
        <a href="#chan-dung">02 · % Cơ cấu Liên ngành</a>
        <a href="#trai-nghiem">03 · % Chuyển đổi &amp; Hài lòng</a>
        <a href="#omlas">04 · % Tác động Quốc tế (OMLAS)</a>
        <a href="#nguon-du-lieu">05 · Bảng Nguồn Dữ liệu</a>
      </nav>

      <!-- ================= 00. EXECUTIVE SUMMARY KPI GRID (PERCENTAGE-FIRST) ================= -->
      <div id="tong-quan">
        <div class="impact-kpi-grid">
          <div class="impact-kpi-card accent-cobalt">
            <span class="impact-kpi-tag">Tốc độ tăng trưởng kênh</span>
            <div class="impact-kpi-num">+{stats.instagram.growth_pct}%</div>
            <div class="impact-kpi-label">Tăng trưởng Instagram &amp; Độ phủ số</div>
            <div class="impact-kpi-sub">
              Tổng <strong>{stats.instagram.total_social_followers.toLocaleString('vi-VN')}+</strong> người theo dõi: Facebook chiếm <strong>{fbSharePct}%</strong> (~{stats.instagram.facebook_followers.toLocaleString('vi-VN')}) &amp; Instagram chiếm <strong>{igSharePct}%</strong> ({stats.instagram.latest_followers}).
            </div>
          </div>

          <div class="impact-kpi-card accent-crimson">
            <span class="impact-kpi-tag">Tự chủ truyền thông</span>
            <div class="impact-kpi-num">6,7% → 70%</div>
            <div class="impact-kpi-label">Tỉ trọng khán giả từ Fanpage/IG TLA</div>
            <div class="impact-kpi-sub">
              Tỉ lệ người biết đến sự kiện trực tiếp qua kênh chính thức của dự án tăng <strong>+63,3 điểm %</strong> (gấp 10,4 lần) sau 6 tháng hoạt động.
            </div>
          </div>

          <div class="impact-kpi-card accent-terracotta">
            <span class="impact-kpi-tag">Phá vỡ biên giới ngành</span>
            <div class="impact-kpi-num">{stats.audience_profile.non_literature_pct.toString().replace('.', ',')}%</div>
            <div class="impact-kpi-label">Khán giả ngoài ngành Văn chương</div>
            <div class="impact-kpi-sub">
              <strong>26,3%</strong> Công nghệ AI/IT &amp; Kỹ thuật · <strong>21,1%</strong> Thiết kế &amp; Truyền thông · <strong>21,0%</strong> Kinh tế, Luật, Y tế (<em>n = {stats.audience_profile.majors_n}</em>).
            </div>
          </div>

          <div class="impact-kpi-card accent-ochre">
            <span class="impact-kpi-tag">Tác động mở đường</span>
            <div class="impact-kpi-num">{stats.dem1.first_time.first_time_pct.toString().replace('.', ',')}%</div>
            <div class="impact-kpi-label">Lần đầu tiếp xúc thơ diễn xướng</div>
            <div class="impact-kpi-sub">
              {stats.dem1.first_time.first_time_count}/{stats.dem1.first_time.n} người khảo sát ở Đêm thơ #1 chưa từng dự sự kiện thơ diễn xướng; <strong>100%</strong> mong muốn trực tiếp cất tiếng đối thoại.
            </div>
          </div>

          <div class="impact-kpi-card accent-sage">
            <span class="impact-kpi-tag">Chất lượng trải nghiệm</span>
            <div class="impact-kpi-num">{dem1SatisfactionPct}%</div>
            <div class="impact-kpi-label">Mức độ hài lòng (4,62 / 5,0 sao)</div>
            <div class="impact-kpi-sub">
              <strong>100%</strong> phản hồi đạt từ 4–5 sao (trong đó <strong>62,5%</strong> chấm 5 sao tuyệt đối và <strong>37,5%</strong> chấm 4 sao; <em>n = {stats.dem1.rating.n}</em>).
            </div>
          </div>

          <div class="impact-kpi-card accent-crimson">
            <span class="impact-kpi-tag">Tỉ lệ gắn bó &amp; Hiện diện</span>
            <div class="impact-kpi-num">85,2%</div>
            <div class="impact-kpi-label">Tỉ lệ Check-in &amp; Gắn bó đa buổi</div>
            <div class="impact-kpi-sub">
              <strong>85,2%</strong> khách xác nhận có mặt tại Đêm thơ #1 (23/27); <strong>{stats.aqm.multi_session_pct.toString().replace('.', ',')}%</strong> học viên đi từ 2–3 buổi ở chuỗi <em>Nghe–Thấy–Nhau</em>.
            </div>
          </div>

          <div class="impact-kpi-card accent-cobalt">
            <span class="impact-kpi-tag">Cơ cấu tương tác (n = {stats.overview.total_registrations_and_surveys})</span>
            <div class="impact-kpi-num">{vnSharePct}% · {intlSharePct}%</div>
            <div class="impact-kpi-label">Trong nước (HN) vs. Quốc tế (OMLAS)</div>
            <div class="impact-kpi-sub">
              <strong>{vnSharePct}%</strong> ({stats.overview.vn_registrations} lượt) tại Hà Nội &amp; <strong>{intlSharePct}%</strong> ({stats.overview.intl_surveys} lượt) quốc tế; lưu trữ <strong>{stats.overview.handwritten_manuscripts}</strong> bản thảo thủ công.
            </div>
          </div>

          <div class="impact-kpi-card accent-sage">
            <span class="impact-kpi-tag">Cam kết &amp; Sẵn sàng sáng tác</span>
            <div class="impact-kpi-num">{stats.omlas.commitment_pct.toString().replace('.', ',')}%</div>
            <div class="impact-kpi-label">Học viên OMLAS sẵn sàng &amp; cam kết</div>
            <div class="impact-kpi-sub">
              <strong>87,0%</strong> tự tin bắt tay sáng tác thơ/nghệ thuật (Q14) &amp; cam kết đi trọn lộ trình; tỉ lệ tuyển chọn Thủ lĩnh đạt <strong>{championsSelectPct}%</strong> (17/23).
            </div>
          </div>
        </div>
      </div>

      <!-- ================= 01. DIGITAL REACH & CHANNEL MATURITY ================= -->
      <div id="do-phu-kenh" class="impact-section-head">
        <span class="section-idx">Phần 01 · Tỉ lệ Độ phủ Trực tuyến &amp; Dịch chuyển Kênh Truyền thông (%)</span>
        <h2>Từ mạng lưới cá nhân (70% truyền miệng) đến hệ sinh thái tự chủ (70% kênh chính thức)</h2>
        <p>
          Phân tích cơ cấu theo tỉ lệ phần trăm (<strong>%</strong>) trên hai nền tảng mạng xã hội và 4 đợt khảo sát nguồn tiếp cận cho thấy tốc độ mở rộng độ phủ và khả năng tự thu hút khán giả độc lập của <em>Thơ-là-ai?</em>.
        </p>
      </div>

      <div class="social-dual-grid">
        <div class="social-stat-card highlight">
          <span class="plat-badge">Tổng quy mô Đa nền tảng (100%)</span>
          <div class="plat-num">{stats.instagram.total_social_followers.toLocaleString('vi-VN')}+</div>
          <div class="plat-desc">
            Kết hợp cộng đồng theo dõi trên cả Facebook (<strong>{fbSharePct}%</strong> tổng quy mô) và Instagram (<strong>{igSharePct}%</strong> tổng quy mô) tính đến kỳ thống kê {stats.instagram.latest_asof}.
          </div>
        </div>

        <div class="social-stat-card">
          <span class="plat-badge">Facebook Fanpage · Chiếm {fbSharePct}% độ phủ</span>
          <div class="plat-num" style="color:var(--chart-cobalt)">{fbSharePct}%</div>
          <div class="plat-desc">
            Tương đương <strong>~{stats.instagram.facebook_followers.toLocaleString('vi-VN')} người theo dõi</strong> — kênh chủ lực lan tỏa các bài tiểu luận thơ, mở đơn đăng ký và kết nối đối tác học thuật.
          </div>
        </div>

        <div class="social-stat-card">
          <span class="plat-badge">Instagram (@tholaai) · Tăng trưởng +{stats.instagram.growth_pct}%</span>
          <div class="plat-num" style="color:var(--brand-crimson)">+{stats.instagram.growth_pct}%</div>
          <div class="plat-desc">
            Tăng từ 50 lên <strong>{stats.instagram.latest_followers} người theo dõi</strong> (gấp <strong>10,16 lần</strong> / đạt <strong>1.016%</strong> so với quy mô ban đầu) qua 7 cột mốc sự kiện.
          </div>
        </div>
      </div>

      <LineChart
        title="Đường cong tăng trưởng Instagram (@tholaai): Số lượng & Tỉ lệ % tăng trưởng lũy kế qua 7 mốc"
        points={ig}
        strokeColor="var(--chart-cobalt)"
        note={`Mốc gốc 11/2025 = 50 người theo dõi (100%). Tỉ lệ % màu đỏ trên từng đỉnh biểu thị mức tăng trưởng lũy kế so với mốc đầu tiên: +300% → +606% → +666% → +712% → +824% → +916%.`}
      />

      <div class="impact-insight-box crimson">
        <div class="impact-insight-title">Phát hiện trọng tâm #1 · Tỉ trọng kênh tự nhiên (Organic Reach) tăng từ 6,7% lên 70,0%</div>
        <p>
          Khi quy đổi câu hỏi <em>&ldquo;Bạn biết đến chương trình qua kênh nào?&rdquo;</em> (<strong>n = {stats.channels_summary.total_respondents}</strong>) sang tỉ lệ phần trăm, chúng ta thấy rõ sự trưởng thành của thương hiệu: Ở Đêm thơ #1 (11/2025), <strong>70,0%</strong> người tham dự đến từ lời giới thiệu của bạn bè và chỉ <strong>6,7%</strong> biết qua trang dự án. Đến chuỗi <em>Nghe–Thấy–Nhau</em> (12/2025), kênh dự án tăng lên <strong>30,0%</strong> (cùng <strong>60,0%</strong> từ đối tác AQM). Đến tháng 05/2026 (Workshop <em>Đưa thơ về mặt đất</em>), <strong>70,0%</strong> người đăng ký chủ động tìm đến từ chính Fanpage/Instagram của <em>Thơ-là-ai?</em>.
        </p>
        <div class="shift-step-grid">
          {stats.channels_summary.fanpage_share_trend.map((s) => (
            <div class="shift-step">
              <div class="step-date">{s.event}</div>
              <div class="step-pct">{s.pct.toString().replace('.', ',')}%</div>
              <div class="step-bar"><div class="step-bar-fill" style={`width:${s.pct}%`}></div></div>
              <div class="step-meta">Tỉ lệ biết qua Fanpage / IG dự án (<em>n = {s.n}</em>)</div>
            </div>
          ))}
        </div>
      </div>

      <div class="grid cols-2 top" style="margin-top:1.5rem">
        <BarList
          title="Tỉ lệ % nguồn tiếp cận tổng hợp qua 4 chương trình"
          items={stats.channels_summary.aggregate}
          n={stats.channels_summary.total_respondents}
          unit="người"
          color="cobalt"
          note="Câu hỏi nhiều lựa chọn (Multiple-choice); tỉ lệ % tính trên tổng số n = 69 người trả lời khảo sát."
        />
        <BarList
          title="Tỉ lệ % kênh tiếp cận · Đêm thơ #1 (11/2025)"
          items={stats.dem1.channels}
          n={stats.dem1.channels_n}
          unit="người"
          color="crimson"
          note="Giai đoạn khởi đầu: 70,0% (21/30) biết đến qua bạn bè, người thân; 10,0% từ các nhóm cộng đồng thơ."
        />
      </div>

      <div class="grid cols-3 top" style="margin-top:1.25rem">
        <BarList
          title='Tỉ lệ % kênh · "Nghe–Thấy–Nhau" (12/2025)'
          items={stats.aqm.channels}
          n={stats.aqm.channels_n}
          unit="người"
          color="sage"
          note="60,0% biết qua đối tác A Queer Museum; 30,0% qua kênh Thơ-là-ai?; 15,0% qua bạn bè."
        />
        <BarList
          title='Tỉ lệ % kênh · "Chồng chữ" (03/2026)'
          items={stats.chongchu.channels}
          n={stats.chongchu.channels_n}
          unit="người"
          color="ochre"
          note="Nhóm điền form trước (n = 9): 44,4% qua bạn bè, 33,3% qua đối tác AQM."
        />
        <BarList
          title='Tỉ lệ % kênh · "Đưa thơ về mặt đất" (05/2026)'
          items={stats.tanhinhthuc.channels}
          n={stats.tanhinhthuc.channels_n}
          unit="người"
          color="terracotta"
          note="70,0% người đăng ký đến trực tiếp từ Fanpage/IG Thơ-là-ai?; 40,0% từ bạn bè giới thiệu."
        />
      </div>

      <!-- ================= 02. AUDIENCE DEMOGRAPHICS & INTERDISCIPLINARY REACH ================= -->
      <div id="chan-dung" class="impact-section-head">
        <span class="section-idx">Phần 02 · Cơ cấu Phần trăm Chân dung Người tham dự (%)</span>
        <h2>Phá vỡ định kiến &ldquo;tháp ngà văn chương&rdquo;: 68,4% người tham dự đến từ ngoài ngành Văn học</h2>
        <p>
          Phân tích cơ cấu phần trăm chuyên ngành và độ tuổi chứng minh thơ đương đại có sức hút mạnh mẽ với nhóm người trẻ làm việc trong lĩnh vực Công nghệ (AI/IT), Kỹ thuật, Thiết kế và Kinh tế.
        </p>
      </div>

      <div class="impact-insight-box sage">
        <div class="impact-insight-title">Phát hiện trọng tâm #2 · Cơ cấu 100% Khán giả theo Khối ngành (n = 38)</div>
        <p>
          Khi phân tách 100% mẫu khảo sát chuyên ngành/nghề nghiệp (<em>n = 38</em>): Nhóm <strong>ngoài ngành Văn chương – Nhân văn chiếm áp đảo 68,4%</strong>, bao gồm: <strong>26,3%</strong> Công nghệ (AI, IT, Khoa học máy tính), Kỹ thuật &amp; Khoa học tự nhiên; <strong>21,1%</strong> Thiết kế đồ họa, Truyền thông &amp; Sự kiện; <strong>10,5%</strong> Kinh tế, Quản trị, Ngoại giao &amp; Luật; và <strong>10,5%</strong> Y tế, Hàng không, Dịch vụ &amp; Tự do. Khối <strong>Khoa học Xã hội, Nhân văn &amp; Sư phạm chiếm 31,6%</strong>.
        </p>
      </div>

      <div class="grid cols-2 top" style="margin-top:1.5rem">
        <BarList
          title="Tỉ lệ % cơ cấu ngành học & lĩnh vực công việc tại Việt Nam"
          items={stats.audience_profile.majors}
          n={stats.audience_profile.majors_n}
          unit="người"
          color="cobalt"
          note="Tổng cộng 100% (n = 38): 68,4% thuộc các ngành Công nghệ, Thiết kế, Kinh tế, Dịch vụ; 31,6% thuộc khối KHXH & Nhân văn."
        />
        <BarList
          title="Tỉ lệ % phân bố độ tuổi người tham dự tại Hà Nội"
          items={stats.audience_profile.age_vn_buckets}
          n={stats.audience_profile.age_vn_n}
          unit="người"
          color="sage"
          note="Tổng cộng 100% (n = 30): 53,3% từ 22 tuổi trở xuống (Sinh viên/THPT) và 46,7% trên 22 tuổi (Người đi làm/Sau ĐH)."
        />
      </div>

      <div class="grid cols-2 top" style="margin-top:1.25rem">
        <BarList
          title='Tỉ lệ % người tham dự theo từng buổi · Series "Nghe–Thấy–Nhau"'
          items={stats.aqm.sessions_breakdown}
          n={stats.aqm.registrations}
          unit="người"
          color="terracotta"
          note="Tỉ lệ người đăng ký tham gia tăng từ 33,3% ở Buổi 1 (7/21) lên 47,6% ở Buổi 2 (10/21) và đạt 71,4% ở Buổi 3 (15/21)."
        />
        <figure class="figure chart-crimson">
          <h3>Tỉ lệ % Gắn bó Đa buổi &amp; Đồng thuận Lưu trữ</h3>
          <span class="n-badge">n = {stats.aqm.registrations} người đăng ký (100%)</span>
          <div class="rating-display" style="margin-top:1.2rem">
            <span class="rating-num" style="color:var(--brand-crimson)">{stats.aqm.multi_session_pct.toString().replace('.', ',')}%</span>
            <span class="rating-max">({stats.aqm.multi_session_count}/{stats.aqm.registrations} người) đi từ 2–3 buổi</span>
          </div>
          <p style="font-family:var(--font-ui);font-size:.92rem;color:var(--ink-soft);margin:.8rem 0 0;line-height:1.55">
