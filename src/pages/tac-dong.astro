---
import Base from '../layouts/Base.astro';
import BarList from '../components/BarList.astro';
import LineChart from '../components/LineChart.astro';
import Dumbbell from '../components/Dumbbell.astro';
import stats from '../data/stats.json';

const ig = [
  ...stats.instagram.milestones.map((m) => ({ label: m.label, value: m.followers })),
  { label: 'Hiện tại', value: stats.instagram.latest_followers },
];
const dist = stats.dem1.rating.dist as Record<string, number>;
const dots = [5, 4, 3, 2, 1].flatMap((s) => Array.from({ length: dist[String(s)] ?? 0 }, () => s));
---
<Base title="Tác động" description="Số liệu tổng hợp, đã ẩn danh, về các chương trình của Thơ-là-ai.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Số liệu mở</p>
      <h1 class="shadowed">Tác động</h1>
      <p class="lead">Những con số dưới đây được tổng hợp từ biểu mẫu đăng ký và khảo sát của chương trình. Chúng tôi không công bố tên, thông tin liên hệ hay số tiền.</p>
      <div class="callout">
        <strong>Đọc kỹ trước khi trích dẫn.</strong> Đa số mẫu rất nhỏ (từ vài người đến vài chục người), nên mỗi biểu đồ đều ghi rõ <em>n</em>. Đây là bức tranh về một cộng đồng nhỏ đang lớn dần, không phải thống kê đại diện. Nhóm dưới 3 người được gộp vào &ldquo;Khác&rdquo; để bảo vệ người trả lời.
      </div>

      <h2 style="margin-top:3rem">Cộng đồng đang lớn lên</h2>
      <LineChart title="Người theo dõi Instagram qua các chương trình" points={ig}
        note={`Mốc theo ghi chép của ban tổ chức; điểm cuối là số hiện tại (${stats.instagram.latest_asof}). Facebook: khoảng ${stats.instagram.facebook_followers.toLocaleString('vi-VN')} người theo dõi.`} />

      <h2 style="margin-top:3rem">Mọi người biết đến chúng tôi từ đâu?</h2>
      <div class="grid cols-2">
        <BarList title="Đêm thơ đầu tiên (11/2025)" items={stats.dem1.channels} n={stats.dem1.channels_n} unit="lượt" note="Có thể chọn nhiều nguồn." />
        <BarList title='Series "Nghe–Thấy–Nhau" (12/2025)' items={stats.aqm.channels} n={stats.aqm.channels_n} unit="lượt" note="Đối tác đóng vai trò lớn trong buổi giới thiệu ban đầu." />
        <BarList title='Workshop "Đưa thơ về mặt đất" (05/2026)' items={stats.tanhinhthuc.channels} n={stats.tanhinhthuc.channels_n} unit="lượt" note="Phần lớn người đăng ký đến từ chính fanpage của dự án." />
      </div>

      <h2 style="margin-top:3rem">Ai đến với thơ?</h2>
      <div class="grid cols-2">
        <BarList title='Độ tuổi, series "Nghe–Thấy–Nhau"' items={stats.aqm.age.buckets} n={stats.aqm.age.n} />
        <figure class="figure">
          <h3>Đêm thơ đầu tiên: mức hài lòng</h3>
          <span class="n-badge">n = {stats.dem1.rating.n}</span>
          <div class="dots" role="img" aria-label={`Điểm trung bình ${stats.dem1.rating.mean} trên 5, ${stats.dem1.rating.n} phản hồi`} style="margin-top:1rem">
            {dots.map((s) => <span class="dot" title={`${s} sao`}></span>)}
          </div>
          <p style="font-size:2.4rem;font-family:var(--font-display);font-style:italic;margin:.5rem 0 0">{stats.dem1.rating.mean.toString().replace('.', ',')} <span style="font-size:1.1rem">/ 5</span></p>
          <figcaption>Mỗi chấm là một phản hồi (5 phản hồi 5 sao, 3 phản hồi 4 sao). Với mẫu này chúng tôi chỉ chia sẻ như một lát cắt, không như kết luận.</figcaption>
        </figure>
      </div>

      <h2 style="margin-top:3rem">OMLAS · Echoes of Asia</h2>
      <p class="prose">Chương trình quốc tế dành cho thanh niên nhiều quốc gia. Người học tự đánh giá năng lực trên thang 1–5 ở đầu kỳ (T0) và giữa kỳ (T1).</p>
      <div class="grid cols-2">
        <BarList title="Người học theo hub quốc gia (T0)" items={stats.omlas.hubs_t0} n={stats.omlas.t0_n} />
        <BarList title="Người học theo hub quốc gia (T1)" items={stats.omlas.hubs_t1} n={stats.omlas.t1_n} />
      </div>
      <Dumbbell title="Tự đánh giá năng lực: đầu kỳ và giữa kỳ" items={stats.omlas.items} n0={stats.omlas.t0_n} n1={stats.omlas.t1_n}
        note="Chấm rỗng = đầu kỳ (T0), chấm đặc = giữa kỳ (T1). Số bên phải là chênh lệch điểm trung bình." />
      <div class="callout">{stats.omlas.caveat} Mục &ldquo;viết/thơ để xử lý cảm xúc&rdquo; gần như không đổi, nên cần theo dõi thêm về sau.</div>
    </div>
  </section>
</Base>
