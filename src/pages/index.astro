---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import PoemCard from '../components/PoemCard.astro';
import site from '../data/site.json';
import poems from '../data/poems.json';
import gallery from '../data/gallery.json';
import { u } from '../lib/url';

const all = await getCollection('events');
const past = all.filter((e) => e.data.status !== 'planned')
  .sort((a, b) => (b.data.sortDate?.getTime() ?? 0) - (a.data.sortDate?.getTime() ?? 0));
const planned = all.filter((e) => e.data.status === 'planned');
const featuredPoems = ['duyen-khoi', 'kamikaze-2']
  .map((id) => poems.find((p) => p.id === id)).filter((p): p is (typeof poems)[number] => !!p);
// Mỗi chương trình lấy 1 ảnh đại diện cho dải ảnh trang chủ
const seen = new Set<string>();
const featuredPhotos = gallery.filter((g) => !seen.has(g.eventSlug) && seen.add(g.eventSlug)).slice(0, 6);
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="wordmark" role="img" aria-label="Thơ là AI?">
        <span class="wm-tho">Thơ</span>
        <span class="wm-la"></span>
        <span class="wm-ai">AI?</span>
        <i class="spark s1" aria-hidden="true">✦</i>
        <i class="spark s2" aria-hidden="true">✦</i>
        <i class="spark s3" aria-hidden="true">✦</i>
      </div>
      <div class="hero-copy">
        <p class="eyebrow">Thơ diễn xướng · Hà Nội</p>
        <p class="lead">{site.tagline} Không có quy tắc nào cả: quy tắc để sáng tạo và thể nghiệm ở đây là&hellip; không có.</p>
        <div class="btn-row">
          <a class="btn" href={u('/chuong-trinh')}>Chương trình</a>
          <a class="btn ghost" href={u('/kho-tho')}>Nghe thơ</a>
          <a class="btn ghost" href={u('/zine')}>Đọc Zine</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="stats">
      {site.numbers.map((n) => (
        <div class="stat"><div class="num">{n.value}</div><div class="lab">{n.label}</div></div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Hành trình đã đi qua</p><h2>Chương trình</h2></div>
        <a class="link-arrow" href={u('/chuong-trinh')}>Xem tất cả →</a>
      </div>
      <div class="grid cols-3">
        {past.slice(0, 6).map((e) => <EventCard slug={e.id} {...e.data} />)}
      </div>
    </div>
  </section>

  <section class="section band-dark">
    <div class="wrap">
      <p class="eyebrow">Một câu hỏi để bắt đầu</p>
      <h2>Khi nghe từ &ldquo;thơ&rdquo;, hình ảnh đầu tiên hiện lên trong đầu bạn là gì?</h2>
      <div class="poll" role="group" aria-label="Chọn một hình ảnh">
        <button type="button" data-reply="Có thể. Và thơ cũng có thể không cần vần.">Niêm luật, vần điệu</button>
        <button type="button" data-reply="Vẻ đẹp nằm ở cả những điều bình dị.">Vẻ đẹp</button>
        <button type="button" data-reply="Chạm: khi chữ có một cơ thể và một giọng nói.">Chạm</button>
        <button type="button" data-reply="Tình cảm của bạn, kể bằng cách của bạn.">Tình cảm</button>
      </div>
      <p class="poll-reply" id="poll-reply" aria-live="polite">&nbsp;</p>
      <p class="meta">Bốn đáp án lấy từ khảo sát trong Zine &ldquo;Thơ là ai?&rdquo;.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Lắng nghe &amp; đọc</p><h2>Thơ &amp; thanh âm</h2></div>
        <a class="link-arrow" href={u('/kho-tho')}>Mở Kho thơ →</a>
      </div>
      <div class="grid cols-2 top">
        {featuredPoems.map((p) => <PoemCard poem={p} previewLines={6} />)}
      </div>
    </div>
  </section>

  <section class="section band-grey">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Lưu trữ thị giác</p><h2>Khoảnh khắc</h2></div>
        <a class="link-arrow" href={u('/thu-vien')}>Xem {gallery.length} ảnh →</a>
      </div>
      <div class="gallery-square">
        {featuredPhotos.map((img) => (
          <a class="gallery-item" href={u(`/chuong-trinh/${img.eventSlug}`)}>
            <img src={u(img.src)} width={img.width} height={img.height} alt={img.title} loading="lazy" />
            <div class="gallery-caption"><span class="prog">{img.program}</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-dark">
    <div class="wrap zine-band">
      <div>
        <p class="eyebrow">Ấn phẩm kỹ thuật số</p>
        <h2>Zine &ldquo;Thơ-là-ai?&rdquo;</h2>
        <p style="font-size:1.15rem;opacity:.9;max-width:44ch">60 trang song ngữ Việt – Anh: tuyên ngôn nghệ thuật, các đêm thơ diễn xướng, chuỗi thực hành tại A Queer Museum và hậu trường phim ngắn &ldquo;Vọng&rdquo;.</p>
        <p style="margin-top:1.5rem"><a class="btn light" href={u('/zine')}>Lật đọc Zine →</a></p>
      </div>
      <a class="zine-cover" href={u('/zine')}><img src={u('/zine/p01.webp')} alt="Bìa Zine Thơ-là-ai?" width="1224" height="689" /></a>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <p class="eyebrow">Từ người tham dự</p>
      <blockquote>&ldquo;Hóa ra Queer nó không chỉ ở giới tính mà nó còn ở vần thơ.&rdquo;</blockquote>
      <p>Chúng tôi tin thơ có thể bắt đầu từ chất liệu đời sống bình dị, và mỗi người, kể cả khi chưa từng viết, đều có thể có một bài thơ của riêng mình.</p>
      {planned.length > 0 && <p class="meta">Đang ấp ủ: {planned.map((e) => e.data.title).join(' · ')}.</p>}
    </div>
  </section>
</Base>

<script>
  const reply = document.getElementById('poll-reply')!;
  document.querySelectorAll<HTMLButtonElement>('.poll button').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('.poll button').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      b.setAttribute('aria-pressed', 'true');
      reply.textContent = b.dataset.reply ?? '';
    });
  });
</script>
