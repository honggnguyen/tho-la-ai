---
import Base from '../layouts/Base.astro';
import gallery from '../data/gallery.json';
import { u } from '../lib/url';

// Cấu trúc 7 Album theo trình tự thời gian và chủ đề rõ ràng
const albums = [
  {
    slug: '2025-11-dem-tho-dien-xuong',
    order: '01',
    title: 'Đêm thơ diễn xướng "Thơ-là-ai?" #1',
    dateLabel: '21/11/2025',
    venue: 'Kim Mã, Ba Đình, Hà Nội',
    summary: 'Đêm thơ đầu tiên kết hợp kịch, âm thanh và cuộc đối thoại liên thế hệ giữa các nghệ sĩ gạo cội và người trẻ.',
  },
  {
    slug: '2025-12-nghe-thay-nhau',
    order: '02',
    title: 'Series "Nghe–Thấy–Nhau"',
    dateLabel: '14/12/2025 – 11/01/2026',
    venue: 'A Queer Museum, 103 Ngọc Lâm, Long Biên',
    summary: 'Chuỗi 3 buổi thực hành thơ thủ công, blackout poetry và lắng nghe tự sự Queer qua ngôn ngữ đa giác quan.',
  },
  {
    slug: '2026-03-chong-chu',
    order: '03',
    title: 'Workshop "Chồng chữ"',
    dateLabel: '15/03/2026',
    venue: 'A Queer Museum, 103 Ngọc Lâm, Long Biên',
    summary: 'Thực hành cắt dán (collage), tái định hình từ vựng và tự do thể nghiệm thơ thị giác.',
  },
  {
    slug: '2026-04-choi-giua-mua-trang-vong',
    order: '04',
    title: 'Sự kiện "Chơi giữa mùa trăng" & Dự án "Vọng"',
    dateLabel: '24/04/2026',
    venue: 'Tổ Chim Xanh, 27 Đặng Dung, Ba Đình',
    summary: 'Không gian diễn xướng và dự án điện ảnh thơ thể nghiệm lấy cảm hứng từ thế giới thi ca Hàn Mặc Tử.',
  },
  {
    slug: '2026-05-03-nuoc-va-mo',
    order: '05',
    title: 'Trình diễn thơ nhạc "Nước và Mơ"',
    dateLabel: '03/05/2026',
    venue: 'Quán Cầm, Gác 3, Số 6 Nguyễn Thượng Hiền',
    summary: 'Buổi trình diễn thơ đương đại hòa quyện cùng âm nhạc ứng tác xoay quanh dáng hình của nước và nhạc tính tiếng Việt.',
  },
  {
    slug: '2026-05-dua-tho-ve-mat-dat',
    order: '06',
    title: 'Workshop "Đưa thơ về mặt đất"',
    dateLabel: '17/05/2026',
    venue: 'TOTO Cafe, Số 1 ngõ 84 Trần Thái Tông, Cầu Giấy',
    summary: 'Workshop thơ tân hình thức cùng nhà thơ Phapxa Chan: nói thơ, nấu thơ và nối thơ trong nhịp sống đương đại.',
  },
  {
    slug: '2026-09-omlas-echoes-of-asia',
    order: '07',
    title: 'OMLAS · Echoes of Asia',
    dateLabel: '09/2026',
    venue: 'Quốc tế (Online / 5 Hubs)',
    summary: 'Dự án Poetic Resilience và năng lực lãnh đạo trẻ tại Việt Nam, Thái Lan, Bangladesh, Pakistan và Uzbekistan.',
  },
];

// Gắn danh sách ảnh và sản phẩm lưu trữ vào từng album
const albumsWithPhotos = albums.map((alb) => {
  const allItems = gallery.filter((g) => g.eventSlug === alb.slug);
  const photos = allItems.filter((g) => g.kind !== 'product');
  const products = allItems.filter((g) => g.kind === 'product');
  return {
    ...alb,
    items: allItems,
    photos,
    products,
    totalCount: allItems.length,
    photoCount: photos.length,
    productCount: products.length,
  };
}).filter((alb) => alb.totalCount > 0);

const totalPhotos = gallery.filter((g) => g.kind !== 'product').length;
const totalProducts = gallery.filter((g) => g.kind === 'product').length;
---
<Base title="Thư viện ảnh & Sản phẩm lưu trữ" description="Kho lưu trữ thị giác có cấu trúc từ các đêm thơ, bản thảo chép tay và workshop của Thơ-là-ai?.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Kho lưu trữ thị giác · {albumsWithPhotos.length} bộ sưu tập · {totalPhotos} ảnh chụp · {totalProducts} bản thảo lưu trữ</p>
      <h1 class="shadowed">Thư viện ảnh</h1>
      <p class="lead">Những khoảnh khắc sự kiện cùng toàn bộ bản thảo thơ chép tay, thơ thủ công và sản phẩm sáng tác của người tham gia được phân loại ngăn nắp theo từng sự kiện.</p>

      <div class="callout" style="border-left-color:var(--chart-cobalt);margin:1.8rem 0;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1.2rem">
        <div style="max-width:54ch">
          <strong style="font-family:var(--font-ui);text-transform:uppercase;letter-spacing:.08em;color:var(--chart-cobalt)">▶ Kho tư liệu Video &amp; Thước phim 4K</strong>
          <p style="margin:.3rem 0 0;font-size:1.02rem">Để đảm bảo tốc độ tải trang nhanh và trải nghiệm mượt mà, video recap và diễn xướng được nhúng qua YouTube. Các footage quay 4K gốc được lưu trữ mở trên Google Drive.</p>
        </div>
        <div style="display:flex;gap:.6rem;flex-wrap:wrap">
          <a class="btn" href="https://www.youtube.com" target="_blank" rel="noopener" style="font-size:.92rem;padding:.45rem .95rem">Kênh YouTube ↗</a>
          <a class="btn ghost" href="https://drive.google.com/drive/folders/19qD6_pfXld1Jijt-MJMrI35ZvI8V6j1h" target="_blank" rel="noopener" style="font-size:.92rem;padding:.45rem .95rem">Kho Google Drive ↗</a>
        </div>
      </div>

      <!-- Thanh chọn lọc nhanh -->
      <div class="filter-bar" role="region" aria-label="Lọc theo Album hoặc Thể loại">
        <button type="button" class="filter-btn alb-filter-btn" data-slug="all" aria-pressed="true">
          Tất cả Album ({albumsWithPhotos.length})
        </button>
        <button type="button" class="filter-btn alb-filter-btn" data-slug="products" aria-pressed="false" style="border-color:var(--chart-terracotta);color:var(--chart-terracotta);font-weight:700">
          📜 Bản thảo &amp; Sản phẩm lưu trữ ({totalProducts})
        </button>
        {albumsWithPhotos.map((alb) => (
          <button type="button" class="filter-btn alb-filter-btn" data-slug={alb.slug} aria-pressed="false">
            {alb.order}. {alb.title.replace(/^[^"]*"|"[^"]*$/g, '')} ({alb.totalCount})
          </button>
        ))}
      </div>

      <!-- Danh sách Album theo trật tự thời gian -->
      <div class="gallery-albums" id="albums-container">
        {albumsWithPhotos.map((alb) => {
          const hasMore = alb.totalCount > 6;
          return (
            <article class="album-card" id={`album-${alb.slug}`} data-slug={alb.slug} data-has-products={alb.productCount > 0 ? 'true' : 'false'}>
              <header class="album-header">
                <div class="album-meta-top">
                  <span class="album-order-badge">Album {alb.order}</span>
                  <span class="meta">{[alb.dateLabel, alb.venue].filter(Boolean).join(' · ')}</span>
                  <span class="album-count-badge">
                    {alb.photoCount > 0 && `${alb.photoCount} ảnh`}
                    {alb.photoCount > 0 && alb.productCount > 0 && ' · '}
                    {alb.productCount > 0 && `${alb.productCount} bản thảo`}
                  </span>
                </div>
                <div class="album-title-row">
                  <h2>{alb.title}</h2>
                  <a class="album-event-link" href={u(`/chuong-trinh/${alb.slug}`)}>Xem bài sự kiện →</a>
                </div>
                <p class="album-summary">{alb.summary}</p>
              </header>

              <div class="album-grid" id={`grid-${alb.slug}`}>
                {alb.items.map((item, idx) => {
                  const isInitiallyHidden = idx >= 6;
                  const isProduct = item.kind === 'product';
                  return (
                    <button
                      type="button"
                      class={`gallery-item ${isProduct ? 'item-product' : 'item-photo'}`}
                      data-prog={item.program}
                      data-slug={u(`/chuong-trinh/${item.eventSlug}`)}
                      data-src={u(item.src)}
                      data-title={item.title}
                      data-kind={isProduct ? 'product' : 'photo'}
                      data-alb={alb.slug}
                      style={isInitiallyHidden ? 'display: none;' : ''}
                      data-hidden-default={isInitiallyHidden ? 'true' : 'false'}
                    >
                      <img src={u(item.src)} width={item.width} height={item.height} alt={item.title} loading="lazy" />
                      <div class="gallery-caption">
                        <span class="prog" style={isProduct ? 'color:var(--chart-terracotta);font-weight:700' : ''}>
                          {isProduct ? '📜 Sản phẩm lưu trữ' : alb.title}
                        </span>
                        <span>{item.title}</span>
                      </div>
                    </button>
                  );
                })}
              </div>

              {hasMore && (
                <button
                  type="button"
                  class="album-toggle-btn"
                  data-target={`grid-${alb.slug}`}
                  data-count={alb.totalCount}
                  data-expanded="false"
                  aria-expanded="false"
                >
                  <span>Xem toàn bộ {alb.totalCount} tư liệu của album này ↓</span>
                </button>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <dialog class="lightbox" id="lightbox" aria-label="Xem ảnh phóng to">
    <div class="lb-body">
      <div class="lb-bar">
        <span id="lb-caption"></span>
        <div style="display:flex;gap:.5rem">
          <button type="button" id="lb-prev" aria-label="Ảnh trước">← Trước</button>
          <button type="button" id="lb-next" aria-label="Ảnh tiếp">Tiếp →</button>
          <button type="button" id="lb-close" aria-label="Đóng">Đóng ✕</button>
        </div>
      </div>
      <img id="lb-img" src="" alt="" />
      <div class="lb-bar">
        <a id="lb-link" href="#">Xem trang chương trình →</a>
        <span id="lb-count" class="meta"></span>
      </div>
    </div>
  </dialog>
</Base>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.alb-filter-btn');
  const albumCards = Array.from(document.querySelectorAll<HTMLElement>('.album-card'));
  const allItems = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-item'));
  const toggleBtns = document.querySelectorAll<HTMLButtonElement>('.album-toggle-btn');

  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCap = document.getElementById('lb-caption')!;
  const lbLink = document.getElementById('lb-link') as HTMLAnchorElement;
  const lbCount = document.getElementById('lb-count')!;

  let activeList: HTMLButtonElement[] = [...allItems];
  let currentIdx = 0;

  // Lọc theo Album hoặc Sản phẩm lưu trữ
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((x) => x.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      const slug = btn.dataset.slug || 'all';

      if (slug === 'all') {
        // Hiện tất cả album theo chế độ thu gọn tiêu chuẩn (6 ảnh)
        albumCards.forEach((card) => {
          card.style.display = '';
          const items = card.querySelectorAll<HTMLButtonElement>('.gallery-item');
          items.forEach((it) => {
            it.style.display = it.dataset.hiddenDefault === 'true' ? 'none' : '';
          });
          const toggle = card.querySelector<HTMLButtonElement>('.album-toggle-btn');
          if (toggle) {
            toggle.dataset.expanded = 'false';
            toggle.setAttribute('aria-expanded', 'false');
            toggle.innerHTML = `<span>Xem toàn bộ ${toggle.dataset.count} tư liệu của album này ↓</span>`;
          }
        });
      } else if (slug === 'products') {
        // Chỉ hiện các album có sản phẩm lưu trữ, và chỉ hiện các item sản phẩm
        albumCards.forEach((card) => {
          const hasProducts = card.dataset.hasProducts === 'true';
          card.style.display = hasProducts ? '' : 'none';
          const items = card.querySelectorAll<HTMLButtonElement>('.gallery-item');
          items.forEach((it) => {
            it.style.display = (hasProducts && it.dataset.kind === 'product') ? '' : 'none';
          });
          const toggle = card.querySelector<HTMLButtonElement>('.album-toggle-btn');
          if (toggle) toggle.style.display = 'none';
        });
        document.getElementById('albums-container')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        // Chỉ hiện album được chọn, tự động mở bung toàn bộ tư liệu
        albumCards.forEach((card) => {
          const isMatch = card.dataset.slug === slug;
          card.style.display = isMatch ? '' : 'none';
          if (isMatch) {
            const items = card.querySelectorAll<HTMLButtonElement>('.gallery-item');
            items.forEach((it) => (it.style.display = ''));
            const toggle = card.querySelector<HTMLButtonElement>('.album-toggle-btn');
            if (toggle) {
              toggle.style.display = '';
              toggle.dataset.expanded = 'true';
              toggle.setAttribute('aria-expanded', 'true');
              toggle.innerHTML = '<span>Thu gọn bớt ↑</span>';
            }
            card.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }

      // Cập nhật danh sách hiển thị cho Lightbox
      activeList = allItems.filter((it) => {
        const card = it.closest('.album-card') as HTMLElement | null;
        return card && card.style.display !== 'none' && it.style.display !== 'none';
      });
    });
  });

  // Nút mở rộng / thu gọn
  toggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target;
      if (!targetId) return;
      const grid = document.getElementById(targetId);
      if (!grid) return;

      const isExpanded = btn.dataset.expanded === 'true';
      const hiddenItems = grid.querySelectorAll<HTMLButtonElement>('.gallery-item[data-hidden-default="true"]');
      const totalCount = btn.dataset.count || '';

      if (isExpanded) {
        hiddenItems.forEach((it) => (it.style.display = 'none'));
        btn.dataset.expanded = 'false';
        btn.setAttribute('aria-expanded', 'false');
        btn.innerHTML = `<span>Xem toàn bộ ${totalCount} tư liệu của album này ↓</span>`;
        grid.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        hiddenItems.forEach((it) => (it.style.display = ''));
        btn.dataset.expanded = 'true';
        btn.setAttribute('aria-expanded', 'true');
        btn.innerHTML = '<span>Thu gọn bớt ↑</span>';
      }
    });
  });

  // Lightbox
  function showLightbox(i: number) {
    if (!activeList.length) return;
    currentIdx = (i + activeList.length) % activeList.length;
    const it = activeList[currentIdx];
    lbImg.src = it.dataset.src || '';
    lbImg.alt = it.dataset.title || '';
    lbCap.textContent = `${it.dataset.prog} · ${it.dataset.title}`;
    lbLink.href = it.dataset.slug || '#';
    lbCount.textContent = `Tư liệu ${currentIdx + 1} / ${activeList.length}`;
  }

  allItems.forEach((it) => {
    it.addEventListener('click', () => {
      activeList = allItems.filter((item) => {
        const card = item.closest('.album-card') as HTMLElement | null;
        return card && card.style.display !== 'none' && item.style.display !== 'none';
      });
      const pos = activeList.indexOf(it);
      showLightbox(pos >= 0 ? pos : 0);
      dlg.showModal();
    });
  });

  document.getElementById('lb-prev')?.addEventListener('click', () => showLightbox(currentIdx - 1));
  document.getElementById('lb-next')?.addEventListener('click', () => showLightbox(currentIdx + 1));
  document.getElementById('lb-close')?.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });

  window.addEventListener('keydown', (e) => {
    if (!dlg.open) return;
    if (e.key === 'ArrowLeft') showLightbox(currentIdx - 1);
    if (e.key === 'ArrowRight') showLightbox(currentIdx + 1);
    if (e.key === 'Escape') dlg.close();
  });
</script>