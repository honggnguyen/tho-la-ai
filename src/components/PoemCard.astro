---
import { u } from '../lib/url';
interface Props {
  poem: { id: string; title: string; author: string; program: string; category: string; audio?: string; note?: string; text: string };
  previewLines?: number;
  showProgram?: boolean;
}
const { poem, previewLines = 5, showProgram = true } = Astro.props;
const lines = poem.text ? poem.text.split('\n') : [];
const needsMore = lines.length > previewLines + 2;
const preview = needsMore ? lines.slice(0, previewLines).join('\n') : poem.text;
const rest = needsMore ? lines.slice(previewLines).join('\n') : '';
---
<article class="poem-card" id={poem.id} data-category={poem.category} data-audio={poem.audio ? 'yes' : 'no'}>
  <div class="poem-top">
    <span class="tag">{poem.category}</span>
    {showProgram && <span class="meta">{poem.program}</span>}
  </div>
  <h3>{poem.title}</h3>
  <div class="poem-author">{poem.author}</div>
  {poem.audio && (
    <div class="audio-box">
      <span class="audio-label">♪ Bản thu âm</span>
      <audio controls preload="none" src={u(poem.audio)}></audio>
    </div>
  )}
  {poem.text && (
    <div class="poem-body-wrap">
      {!needsMore ? (
        <div class="poem-text">{poem.text}</div>
      ) : (
        <div class="poem-expandable">
          <div class="poem-text poem-preview">{preview}…</div>
          <div class="poem-text poem-full" hidden>{poem.text}</div>
          <button type="button" class="poem-expand-btn">Đọc toàn bài ↓</button>
        </div>
      )}
    </div>
  )}
  {poem.note && <p class="poem-note">{poem.note}</p>}
</article>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest('.poem-expand-btn');
    if (!btn) return;
    const parent = btn.closest('.poem-expandable');
    if (!parent) return;
    const preview = parent.querySelector('.poem-preview') as HTMLElement | null;
    const full = parent.querySelector('.poem-full') as HTMLElement | null;
    if (preview) preview.hidden = true;
    if (full) full.hidden = false;
    btn.remove();
  });
</script>
