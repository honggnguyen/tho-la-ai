---
import { u } from '../lib/url';
interface Props { slug: string; title: string; subtitle?: string; status: string; type: string; dateLabel?: string; summary: string; }
const { slug, title, subtitle, status, type, dateLabel, summary } = Astro.props;
const statusLabel: Record<string, string> = { done: type, ongoing: 'Đang diễn ra', planned: 'Dự kiến' };
---
<a class="card" href={u(`/chuong-trinh/${slug}`)}>
  <span class={`tag ${status}`}>{statusLabel[status]}</span>
  <h3>{title}</h3>
  {subtitle && <span class="meta">{subtitle}</span>}
  {dateLabel && <span class="meta">{dateLabel}</span>}
  <p>{summary}</p>
</a>
